# EasyTech Environment Variables Configuration Template
# Paste these in your Netlify Dashboard -> Site Settings -> Environment Variables

# Your Amazon Associates Tag
AFFILIATE_TAG=easytech020-21

# Google Gemini API Key (from Google AI Studio / Notepad)
GEMINI_API_KEY=your_gemini_api_key_here

# Amazon PA API / Creators API Credentials
AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here

# YouTube Channel ID (for easytechtalks360)
YOUTUBE_CHANNEL_ID=easytechtalks360
